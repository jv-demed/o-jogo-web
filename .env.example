# Copie para .env.local e preencha com os valores do painel do Supabase
# (Project Settings -> API). Ambas sao chaves publicas: vao para o bundle.
# Lembrete: o schema `o_jogo` precisa estar em API -> Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
